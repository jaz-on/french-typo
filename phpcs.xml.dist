<?xml version="1.0"?>
<ruleset name="French Typo">
	<description>WordPress Coding Standards plus PHP compatibility for the supported PHP floor.</description>

	<file>.</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>

	<rule ref="WordPress-Extra"/>

	<!-- Keep in sync with "Requires PHP" in french-typo.php and readme.txt. -->
	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
